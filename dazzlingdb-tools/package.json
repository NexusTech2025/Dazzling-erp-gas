{
  "name": "dazzlingdb-tools",
  "version": "1.0.0",
  "description": "Unified CLI and API client utility for DazzlingDB",
  "main": "index.js",
  "scripts": {
    "lint-schema": "node index.js --lint-only",
    "lint-schema:dev": "node index.js --lint-only --env development",
    "lint-schema:prod": "node index.js --lint-only --env production",
    "compile-graph": "node index.js --build",
    "compile-graph:dev": "node index.js --build --env development",
    "compile-graph:prod": "node index.js --build --env production",
    "api-login": "node src/client/actions/login.js",
    "api-query": "node src/client/actions/query.js",
    "clean-courses": "node src/client/actions/clean_courses.js"
  },
  "keywords": [
    "dazzlingdb",
    "compiler",
    "linter"
  ],
  "author": "Moni",
  "license": "ISC",
  "dependencies": {
    "marked": "^18.0.5"
  }
}
