+  function renderCache() {
+    try {
+      const headersList = document.getElementById('cache-headers-list');
+      const sessionsList = document.getElementById('cache-sessions-list');
+      const lockoutsList = document.getElementById('cache-lockouts-list');
+
+      if (headersList) headersList.innerHTML = '<div class="text-center text-muted py-5"><div class="spinner-border text-primary mb-3" role="status"></div><p>Analyzing headers cache...</p></div>';
+      if (sessionsList) sessionsList.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border text-success mb-2" role="status"></div><p>Analyzing session cache...</p></div>';
+      if (lockoutsList) lockoutsList.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border text-danger mb-2" role="status"></div><p>Analyzing lockout cache...</p></div>';
+
+      callApi("admin_cache_analyze", {}, (res) => {
+        try {
+          const cacheData = res.data;
+          if (!cacheData) return;
+
+          // 1. Calculate and update metrics
+          let totalCachedTables = 0;
+          if (cacheData.headers && cacheData.headers.categories) {
+            Object.values(cacheData.headers.categories).forEach(tablesList => {
+              totalCachedTables += tablesList.length;
+            });
+          }
+          
+          let sessionHits = 0;
+          if (cacheData.sessions && cacheData.sessions.list) {
+            sessionHits = cacheData.sessions.list.filter(s => s.isHit).length;
+          }
+          
+          let lockoutsCount = 0;
+          if (cacheData.lockouts && cacheData.lockouts.list) {
+            lockoutsCount = cacheData.lockouts.list.filter(l => l.isLocked).length;
+          }
+
+          document.getElementById('cache-tables-count').textContent = totalCachedTables;
+          document.getElementById('cache-sessions-hits').textContent = `${sessionHits}/${cacheData.sessions ? cacheData.sessions.list.length : 0}`;
+          document.getElementById('cache-lockouts-count').textContent = lockoutsCount;
+
+          // 2. Render Headers Cache list
+          if (headersList) {
+            headersList.innerHTML = "";
+            
+            if (totalCachedTables === 0 && (!cacheData.headers || !cacheData.headers.stale || cacheData.headers.stale.length === 0)) {
+              headersList.innerHTML = '<div class="text-center text-muted py-5"><i class="fas fa-check-circle fa-3x text-success mb-3"></i><p>No table headers currently cached.</p></div>';
+            } else {
+              // Loop through categories
+              if (cacheData.headers && cacheData.headers.categories) {
+                Object.entries(cacheData.headers.categories).forEach(([catName, tablesList]) => {
+                  if (tablesList.length === 0) return;
+
+                  let catGroupHtml = `
+                    <div class="mb-4">
+                      <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-folder me-2 text-warning"></i>${catName} Domain</h6>
+                      <div class="list-group shadow-sm rounded mb-2">
+                  `;
+
+                  tablesList.forEach(t => {
+                    catGroupHtml += `
+                      <div class="list-group-item p-3">
+                        <div class="d-flex justify-content-between align-items-center mb-1">
+                          <span class="fw-bold text-dark">${t.table}</span>
+                          <span class="badge bg-success rounded-pill small">Cached</span>
+                        </div>
+                        <div class="small bg-light p-2 rounded border font-monospace text-secondary" style="font-size: 11px; white-space: pre-wrap; word-break: break-all;">
+                          [ ${t.columns.join(", ")} ]
+                        </div>
+                      </div>
+                    `;
+                  });
+
+                  catGroupHtml += `
+                      </div>
+                    </div>
+                  `;
+                  headersList.innerHTML += catGroupHtml;
+                });
