{
  "primaryKey": "attendance_id",
  "columns": {
    "teacher_id": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "attendance_date": {
      "type": "date",
      "required": true
    },
    "status": {
      "type": "string",
      "required": true,
      "choices": [
        "present",
        "absent",
        "leave",
        "half_day"
      ],
      "maxLength": 255
    },
    "check_in_time": {
      "type": "datetime"
    },
    "check_out_time": {
      "type": "datetime"
    },
    "working_hours": {
      "type": "number"
    },
    "is_paid_leave": {
      "type": "boolean",
      "default": false
    },
    "attendance_source": {
      "type": "string",
      "choices": [
        "manual",
        "biometric",
        "system"
      ],
      "maxLength": 255
    },
    "notes": {
      "type": "string",
      "maxLength": 255
    },
    "marked_by": {
      "type": "string",
      "maxLength": 255
    },
    "attendance_id": {
      "type": "auto",
      "idPrefix": "TAT",
      "editable": false,
      "unique": true,
      "required": false
    }
  },
  "relations": {
    "teacher": {
      "type": "belongsTo",
      "target": "Teacher",
      "foreignKey": "teacher_id"
    }
  }
}